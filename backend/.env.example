HOST=0.0.0.0
PORT=8000
CORS_ORIGIN=http://localhost:5173

LLM_PROVIDER=ollama
LLM_MODEL_NAME=gemma4:e2b
VLLM_BASE_URL=http://localhost:8001
VLLM_API_KEY=EMPTY
LLM_FALLBACK_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=gemma4:e2b
OLLAMA_THINKING=false
LLM_REQUEST_TIMEOUT_S=10
LLM_N_CTX=1536
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7

# Image anomaly annotation (annotate_image tool + /annotate-image endpoint).
# Annotation uses the SAME base LLM as chat — LLM_MODEL_NAME at OLLAMA_BASE_URL — so the
# base model must be a multimodal/vision-capable Ollama model (e.g. gemma4:26b, qwen2.5-vl, llava).
# The values below only tune the annotation task; the model itself is LLM_MODEL_NAME.
VISION_MAX_TOKENS=1024
VISION_TEMPERATURE=0.3
VISION_REQUEST_TIMEOUT_S=120

# Cache directory for images annotated by the annotate_image tool (served under /annotated/images)
ANNOTATED_IMAGE_CACHE_DIR=./annotated_images

# Inspection database (new multi-inspection schema: categories/inspections/images/objects/
# detections, plus anomaly tables added by the writer later). Relative paths resolve
# against the backend/ root.
INSPECTION_DB_PATH=../MTR_Database/inspection_v2.db
# Source camera frames referenced by images.filename (served at /inspection/images).
INSPECTION_IMAGE_DIR=../MTR_Database/outputs/images

# Rerun 3D highlighting. The assistant pushes highlighted coordinates/objects to a
# separately-running Rerun viewer (start it with `rerun`) over TCP. If the viewer is not
# running, the turn still completes with a friendly status string.
RERUN_ENABLED=true
RERUN_VIEWER_ADDR=127.0.0.1:9876
# Rerun application id: matches the grounding pipeline's rerun_bridge_node so highlights
# share the grounding scene's recording space and world frame.
RERUN_APP_ID=inspection_grounding_rerun
# Leveling rotation [roll, pitch, yaw] in degrees, mirroring the grounding pipeline's
# rerun_bridge_node `leveling_rpy_deg`. DB centroids/bboxes are in the tilted camera_init
# frame; this pre-rotates them level onto the grounding map. "0.0,20.0,0.0" = the
# 2026-06-11 inspection run.
RERUN_LEVELING_RPY_DEG=0.0,20.0,0.0
# If true, the backend auto-launches a Rerun viewer the first time it has something to
# visualize and no viewer is reachable on RERUN_VIEWER_ADDR. Set false to require a
# manually-started `rerun` viewer.
RERUN_AUTO_SPAWN=true

# WebSocket keep-alive. Increase these if you see reconnects on idle connections.
# The frontend also sends an application-level heartbeat every 15 seconds.
WS_PING_INTERVAL_S=60
WS_PING_TIMEOUT_S=60

# Speech-to-text backend: "sensevoice" (FunASR, default) or "whisper" (faster-whisper).
# Whisper supports English, Mandarin (zh) and Cantonese (yue); SenseVoice covers zh/en/ja/ko.
STT_BACKEND=sensevoice

# Whisper (faster-whisper / CTranslate2) — only used when STT_BACKEND=whisper.
# Model: large-v3 (best accuracy, ~1.5-2GB VRAM with int8_float16), medium, small,
# or a Systran faster-whisper repo id. The model auto-downloads to WHISPER_DOWNLOAD_ROOT on first use.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda:0
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_LANGUAGE=        # empty = auto-detect; or force "en", "zh", "yue"
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_DOWNLOAD_ROOT=./models/whisper-cache

# SenseVoice (FunASR) — used when STT_BACKEND=sensevoice (default).
# Official snapshot is iic/SenseVoiceSmall; point this at another FunASR model dir to swap models.
SENSEVOICE_MODEL_DIR=./models/SenseVoiceSmall
SENSEVOICE_DEVICE=cuda:0

PIPER_EXE_PATH=./bin/piper/piper/piper.exe
PIPER_DEFAULT_VOICE_ID=en_US-hfc_female-medium
PIPER_CHINESE_VOICE_ID=zh_CN-xiao_ya-medium
PIPER_CHINESE_FALLBACK_VOICE_ID=zh_CN-huayan-medium
PIPER_MODEL_PATH=./models/piper/en_US-amy-medium.onnx
PIPER_CONFIG_PATH=./models/piper/en_US-amy-medium.onnx.json
TTS_SAMPLE_RATE=22050
TTS_MIN_CHUNK_CHARS=28
TTS_FIRST_CHUNK_CHARS=16
